<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.launcher.foldchair">

    <!-- Foldable Device Support -->
    <uses-feature
        android:name="android.hardware.foldable"
        android:required="false" />

    <!-- Display Permissions -->
    <uses-permission android:name="android.permission.ACCESS_DISPLAY_SETTINGS" />
    <uses-permission android:name="android.permission.READ_LOGS" />

    <!-- Standard Launcher Permissions -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_foldchair"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Launcher Activity -->
        <activity
            android:name=".LauncherActivity"
            android:theme="@style/LauncherTheme"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/SettingsTheme"
            android:label="@string/launcher_settings"
            android:exported="false" />

        <!-- App Drawer Activity -->
        <activity
            android:name=".AppDrawerActivity"
            android:theme="@style/AppDrawerTheme"
            android:label="@string/app_drawer"
            android:exported="false" />

        <!-- Foldable Display Service -->
        <service
            android:name=".FoldableDisplayService"
            android:enabled="true"
            android:exported="false" />

        <!-- Configuration Receiver for System Events -->
        <receiver
            android:name=".ConfigurationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.DEVICE_STORAGE_LOW" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
